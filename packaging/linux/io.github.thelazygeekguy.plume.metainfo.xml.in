<?xml version="1.0" encoding="UTF-8"?>
<!-- AppStream metadata (software centres, Flathub). Template: package.sh and the Flatpak
     manifest substitute @VERSION@ and @DATE@ from Cargo.toml and the build date. -->
<component type="desktop-application">
  <id>io.github.thelazygeekguy.plume</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT OR Apache-2.0</project_license>
  <name>Plume</name>
  <summary>Write documents the Word way, saved as Markdown</summary>
  <developer id="io.github.thelazygeekguy">
    <name>Plume contributors</name>
  </developer>
  <description>
    <p>
      Plume is a fast, open-source word processor with a familiar ribbon whose native format is Markdown, with Git versioning planned. It also opens and saves .docx, PDF, ODT, RTF and HTML files, and it can be driven by AI agents over MCP. Plume is based on WordCraft.
    </p>
  </description>
  <launchable type="desktop-id">io.github.thelazygeekguy.plume.desktop</launchable>
  <icon type="stock">io.github.thelazygeekguy.plume</icon>
  <!-- Only url types known to appstream 0.15 (Ubuntu 22.04, where CI validates): no vcs-browser. -->
  <url type="homepage">https://github.com/TheLazyGeekGuy/plume</url>
  <url type="bugtracker">https://github.com/TheLazyGeekGuy/plume/issues</url>
  <url type="help">https://github.com/TheLazyGeekGuy/plume</url>
  <categories>
    <category>Office</category>
    <category>WordProcessor</category>
  </categories>
  <keywords>
    <keyword>word processor</keyword>
    <keyword>docx</keyword>
    <keyword>document</keyword>
    <keyword>writer</keyword>
  </keywords>
  <screenshots>
    <screenshot type="default">
      <caption>The Open Studio Handbook sample with the Navigation pane</caption>
      <image>https://raw.githubusercontent.com/TheLazyGeekGuy/plume/main/docs/images/hero.png</image>
    </screenshot>
  </screenshots>
  <branding>
    <color type="primary" scheme_preference="light">#c9dde3</color>
    <color type="primary" scheme_preference="dark">#1f4e5f</color>
  </branding>
  <requires>
    <display_length compare="ge">760</display_length>
  </requires>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
    <control>tablet</control>
  </supports>
  <!-- Document types Plume opens (#295), as in the desktop entry's MimeType=. -->
  <provides>
    <binary>wordcraft</binary>
    <mediatype>application/vnd.openxmlformats-officedocument.wordprocessingml.document</mediatype>
    <mediatype>application/vnd.ms-word.document.macroEnabled.12</mediatype>
    <mediatype>application/vnd.openxmlformats-officedocument.wordprocessingml.template</mediatype>
    <mediatype>application/vnd.ms-word.template.macroEnabled.12</mediatype>
    <mediatype>application/msword</mediatype>
    <mediatype>application/msword-template</mediatype>
    <mediatype>application/vnd.oasis.opendocument.text</mediatype>
    <mediatype>application/rtf</mediatype>
  </provides>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="@VERSION@" date="@DATE@"/>
  </releases>
</component>
