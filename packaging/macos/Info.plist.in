<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: packaging/macos/package.sh substitutes @VERSION@ (full, e.g. 0.2.0-rc.1),
     @SHORT_VERSION@ (numeric X.Y.Z) and @BUILD_SHA@. -->
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key>
  <string>en</string>
  <key>CFBundleDisplayName</key>
  <string>Plume</string>
  <key>CFBundleName</key>
  <string>Plume</string>
  <key>CFBundleExecutable</key>
  <string>Plume</string>
  <key>CFBundleIdentifier</key>
  <string>io.github.thelazygeekguy.plume</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleSignature</key>
  <string>????</string>
  <key>CFBundleShortVersionString</key>
  <string>@SHORT_VERSION@</string>
  <key>CFBundleVersion</key>
  <string>@SHORT_VERSION@</string>
  <key>WordCraftVersion</key>
  <string>@VERSION@</string>
  <key>WordCraftBuildCommit</key>
  <string>@BUILD_SHA@</string>
  <key>CFBundleIconFile</key>
  <string>Plume</string>
  <key>LSApplicationCategoryType</key>
  <string>public.app-category.productivity</string>
  <!-- Must match MACOSX_DEPLOYMENT_TARGET in package.sh. Big Sur is the first release on
       Apple silicon and has the Metal feature set wgpu targets. -->
  <key>LSMinimumSystemVersion</key>
  <string>11.0</string>
  <key>NSHighResolutionCapable</key>
  <true/>
  <key>NSSupportsAutomaticGraphicsSwitching</key>
  <true/>
  <key>NSRequiresAquaSystemAppearance</key>
  <false/>
  <key>NSHumanReadableCopyright</key>
  <string>Copyright © the Plume contributors and the WordCraft authors. MIT OR Apache-2.0.</string>

  <!-- Documents Plume opens (system type declarations). -->
  <key>CFBundleDocumentTypes</key>
  <array>
    <dict>
      <key>CFBundleTypeName</key>
      <string>Word Document</string>
      <key>CFBundleTypeRole</key>
      <string>Editor</string>
      <key>LSHandlerRank</key>
      <string>Alternate</string>
      <key>LSItemContentTypes</key>
      <array>
        <string>org.openxmlformats.wordprocessingml.document</string>
        <string>org.openxmlformats.wordprocessingml.template</string>
        <string>com.microsoft.word.doc</string>
        <string>org.oasis-open.opendocument.text</string>
        <string>public.rtf</string>
        <string>net.daringfireball.markdown</string>
        <string>public.html</string>
        <string>public.plain-text</string>
      </array>
    </dict>
    <!-- Markdown with its pictures (textbundle.org): a package folder, or one ZIP file. -->
    <dict>
      <key>CFBundleTypeName</key>
      <string>TextBundle</string>
      <key>CFBundleTypeRole</key>
      <string>Editor</string>
      <key>LSHandlerRank</key>
      <string>Alternate</string>
      <key>LSTypeIsPackage</key>
      <true/>
      <key>LSItemContentTypes</key>
      <array>
        <string>org.textbundle.package</string>
      </array>
    </dict>
    <dict>
      <key>CFBundleTypeName</key>
      <string>TextPack</string>
      <key>CFBundleTypeRole</key>
      <string>Editor</string>
      <key>LSHandlerRank</key>
      <string>Alternate</string>
      <key>LSItemContentTypes</key>
      <array>
        <string>org.textbundle.compressed</string>
      </array>
    </dict>
  </array>

  <!-- The TextBundle types, as textbundle.org declares them, for systems that don't know them. -->
  <key>UTImportedTypeDeclarations</key>
  <array>
    <dict>
      <key>UTTypeIdentifier</key>
      <string>org.textbundle.package</string>
      <key>UTTypeDescription</key>
      <string>TextBundle</string>
      <key>UTTypeConformsTo</key>
      <array>
        <string>com.apple.package</string>
        <string>public.composite-content</string>
      </array>
      <key>UTTypeTagSpecification</key>
      <dict>
        <key>public.filename-extension</key>
        <array>
          <string>textbundle</string>
        </array>
      </dict>
    </dict>
    <dict>
      <key>UTTypeIdentifier</key>
      <string>org.textbundle.compressed</string>
      <key>UTTypeDescription</key>
      <string>TextPack</string>
      <key>UTTypeConformsTo</key>
      <array>
        <string>com.pkware.zip-archive</string>
      </array>
      <key>UTTypeTagSpecification</key>
      <dict>
        <key>public.filename-extension</key>
        <array>
          <string>textpack</string>
        </array>
      </dict>
    </dict>
  </array>
</dict>
</plist>
